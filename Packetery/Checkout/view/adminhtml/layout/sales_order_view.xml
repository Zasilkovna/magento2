<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="sales_order_tabs">
            <block class="Packetery\Checkout\Block\Adminhtml\Order\View\Tab\Packetery"
                   name="packetery_order_tab"
                   template="Packetery_Checkout::order/view/tab/packetery.phtml">
                <uiComponent name="packetery_order_detail_form"/>
            </block>
            <action method="addTab">
                <argument name="name" xsi:type="string">packetery</argument>
                <argument name="block" xsi:type="string">packetery_order_tab</argument>
            </action>
        </referenceBlock>
    </body>
</page>
