<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="packetery">
        <job name="importFeedCarriers" instance="Packetery\Checkout\Console\Command\ImportFeedCarriers" method="runForCron">
            <schedule>0 13 * * *</schedule><!-- every first minute of hour 13 -->
        </job>
        <job name="syncPacketStatus" instance="Packetery\Checkout\Console\Command\SyncPacketStatus" method="runForCron">
            <config_path>crontab/packetery/jobs/syncPacketStatus/schedule/cron_expr</config_path><!-- no committed default schedule: devops enables the feature by setting cron_expr (e.g. 17 */3 * * *), disables it by clearing the value -->
        </job>
        <job name="packetery_log_retention" instance="Packetery\Checkout\Cron\LogPurger" method="purgeOld">
            <schedule>0 2 * * *</schedule><!-- every first minute of hour 2 -->
        </job>
    </group>
</config>
